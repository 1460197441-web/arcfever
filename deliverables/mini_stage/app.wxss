page {
  min-height: 100%;
  background: #ffffff;
  color: #111111;
  font-family: "HarmonyOS Sans SC", "PingFang SC", sans-serif;
}

.page-shell {
  min-height: 100vh;
  background: #ffffff;
  padding: 0 0 150rpx;
}

.screen-pad {
  padding: 0 24rpx;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 40;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: calc(54rpx + env(safe-area-inset-top)) 24rpx 18rpx;
  background: rgba(255, 255, 255, 0.96);
}

.brand {
  font-size: 46rpx;
  font-weight: 900;
  letter-spacing: -1rpx;
  color: #111111;
}

.topbar-actions {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.topbar-icon {
  font-size: 30rpx;
  color: #1f2937;
}

.section-space {
  margin-top: 20rpx;
}

.h-scroll {
  white-space: nowrap;
  padding: 0 24rpx 12rpx;
}

.tag-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #4b5563;
  background: #f7f7f7;
}

.tag-pill.active {
  background: #111111;
  color: #ffffff;
}

.feed-list {
  display: flex;
  flex-direction: column;
  gap: 52rpx;
  padding: 14rpx 0 0;
}

.feed-item {
  padding: 0 24rpx;
}

.author-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.author-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.avatar.a1 {
  background: linear-gradient(135deg, #d7ecff 0%, #8dd1ff 100%);
}

.avatar.a2 {
  background: linear-gradient(135deg, #dff4ff 0%, #9ae6ff 100%);
}

.avatar.a3 {
  background: linear-gradient(135deg, #e8efff 0%, #b7c8ff 100%);
}

.avatar.a4 {
  background: linear-gradient(135deg, #d8f5f1 0%, #89e1d1 100%);
}

.author-meta {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.author-name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.author-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #111111;
}

.author-inst {
  font-size: 22rpx;
  color: #6b7280;
}

.verify-badge {
  width: 24rpx;
  height: 24rpx;
  border-radius: 999rpx;
  background: #0ea5e9;
  color: #ffffff;
  font-size: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.verify-badge.green {
  background: #10b981;
}

.menu-dot {
  font-size: 28rpx;
  color: #9ca3af;
}

.hero-copy {
  padding: 0 24rpx;
  margin-top: 4rpx;
  font-size: 26rpx;
  line-height: 1.8;
  color: #4b5563;
}

.poster-box {
  width: 100%;
  aspect-ratio: 4 / 5;
  border-radius: 32rpx;
  overflow: hidden;
  position: relative;
  background: #f5f7fb;
}

.poster-box.square {
  aspect-ratio: 1 / 1;
}

.poster-bg {
  width: 100%;
  height: 100%;
}

.poster-theme-1 {
  background:
    radial-gradient(circle at 70% 20%, rgba(14, 165, 233, 0.28), transparent 20%),
    linear-gradient(135deg, #eaf8ff 0%, #d9f2ff 50%, #f7fbff 100%);
}

.poster-theme-2 {
  background:
    radial-gradient(circle at 20% 20%, rgba(14, 165, 233, 0.18), transparent 18%),
    linear-gradient(135deg, #f8fbff 0%, #eef5ff 100%);
}

.poster-theme-3 {
  background:
    radial-gradient(circle at 60% 30%, rgba(16, 185, 129, 0.16), transparent 20%),
    linear-gradient(135deg, #f3fbf8 0%, #ebf7ff 100%);
}

.poster-theme-4 {
  background:
    radial-gradient(circle at 80% 16%, rgba(59, 130, 246, 0.18), transparent 16%),
    linear-gradient(135deg, #f2f7ff 0%, #ffffff 100%);
}

.poster-content {
  position: absolute;
  inset: 0;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.poster-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.remote-pill,
.code-pill,
.price-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  padding: 10rpx 18rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.remote-pill {
  background: rgba(255, 255, 255, 0.92);
  color: #111111;
}

.price-chip {
  background: rgba(255, 255, 255, 0.92);
  color: #111111;
}

.poster-title {
  max-width: 84%;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.25;
  color: #111111;
}

.poster-meta {
  font-size: 22rpx;
  color: #6b7280;
}

.post-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 18rpx 0 14rpx;
}

.action-group {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.action-icon {
  font-size: 32rpx;
  color: #111111;
}

.desc-block {
  font-size: 26rpx;
  line-height: 1.8;
  color: #111111;
}

.desc-strong {
  font-weight: 700;
  margin-right: 12rpx;
}

.micro-note {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: #f7f7f8;
  font-size: 22rpx;
  color: #4b5563;
}

.time-note {
  margin-top: 14rpx;
  font-size: 20rpx;
  color: #9ca3af;
  letter-spacing: 1rpx;
}

.panel-title {
  padding: 0 24rpx;
  margin-top: 28rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #111111;
}

.panel-subtitle {
  padding: 8rpx 24rpx 0;
  font-size: 22rpx;
  color: #6b7280;
}

.form-wrap {
  padding: 0 24rpx;
}

.field-label {
  margin-top: 22rpx;
  font-size: 22rpx;
  color: #6b7280;
}

.field-input,
.field-textarea,
.field-select {
  margin-top: 10rpx;
  width: 100%;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: #f7f7f8;
  padding: 22rpx 20rpx;
  font-size: 26rpx;
  color: #111111;
}

.field-textarea {
  min-height: 180rpx;
}

.primary-cta,
.secondary-cta {
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
}

.primary-cta {
  background: #111111;
  color: #ffffff;
}

.secondary-cta {
  background: #f7f7f8;
  color: #111111;
}

.cta-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 24rpx;
}

.single-cta {
  margin: 28rpx 24rpx 0;
}

.card,
.panel {
  border-radius: 30rpx;
  background: #f7f7f8;
}

.panel {
  padding: 28rpx;
}

.hero-panel {
  padding: 24rpx;
}

.hero-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #f7f7f8;
  color: #6b7280;
  font-size: 22rpx;
}

.hero-title {
  margin-top: 18rpx;
  font-size: 42rpx;
  line-height: 1.25;
  font-weight: 800;
  color: #111111;
}

.hero-title.small,
.hero-title.small-title {
  font-size: 36rpx;
  line-height: 1.32;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 24rpx;
}

.hero-panel .hero-copy {
  padding: 0;
  margin-top: 12rpx;
}

.nav-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 24rpx 10rpx;
}

.section {
  padding: 0 24rpx;
}

.list-stack {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.grid-two {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  padding: 0 24rpx;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 999rpx;
  background: #f7f7f8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  color: #111111;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #f5f5f5;
  color: #4b5563;
  font-size: 22rpx;
}

.chip.active {
  background: #111111;
  color: #ffffff;
}

.search-box {
  flex: 1;
  min-height: 64rpx;
  border-radius: 20rpx;
  background: #f7f7f8;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 20rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #111111;
}

.feature-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.feature-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #111111;
}

.feature-price {
  font-size: 28rpx;
  font-weight: 800;
  color: #111111;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #111111;
}

.top-gap {
  margin-top: 18rpx;
}

.feature-copy {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #4b5563;
}

.meta-text {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9ca3af;
}

.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #f5f5f5;
  font-size: 22rpx;
  color: #111111;
}

.primary-btn,
.ghost-btn,
.light-btn {
  min-height: 92rpx;
  padding: 0 28rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
}

.full-btn {
  width: 100%;
}

.primary-btn {
  background: #111111;
  color: #ffffff;
}

.ghost-btn,
.light-btn {
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  color: #111111;
}

.form-input,
.form-textarea,
.picker-box {
  margin-top: 10rpx;
  width: 100%;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: #f7f7f8;
  padding: 22rpx 20rpx;
  font-size: 26rpx;
  color: #111111;
}

.form-textarea {
  min-height: 180rpx;
}

.empty-state,
.loading-state {
  padding: 120rpx 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: #9ca3af;
}

.detail-block {
  padding: 0 24rpx;
  margin-top: 24rpx;
}

.block-card {
  border-radius: 28rpx;
  background: #f7f7f8;
  padding: 24rpx;
}

.option-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.option-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  font-size: 24rpx;
  color: #4b5563;
}

.option-pill.active {
  background: #111111;
  color: #ffffff;
}

.row-between {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.row-between + .row-between {
  margin-top: 18rpx;
}

.row-label {
  font-size: 24rpx;
  color: #6b7280;
}

.row-value {
  max-width: 60%;
  text-align: right;
  font-size: 26rpx;
  line-height: 1.6;
  color: #111111;
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  padding: 0 24rpx;
}

.info-card {
  border-radius: 24rpx;
  background: #f7f7f8;
  padding: 22rpx;
}

.info-label {
  font-size: 22rpx;
  color: #9ca3af;
}

.info-value {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #111111;
  font-weight: 600;
}

.subtle-copy {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #6b7280;
}

.line-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 14rpx;
}

.line-item {
  font-size: 23rpx;
  line-height: 1.8;
  color: #4b5563;
}

.inline-link {
  color: #0ea5e9;
  font-size: 24rpx;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 18rpx;
}

.switch-copy {
  flex: 1;
}

.check-pill {
  min-width: 88rpx;
  height: 52rpx;
  border-radius: 999rpx;
  background: #e5e7eb;
  color: #6b7280;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
}

.check-pill.active {
  background: #0ea5e9;
  color: #ffffff;
}

.summary-card {
  margin: 24rpx;
  border-radius: 32rpx;
  background: #111111;
  color: #ffffff;
  padding: 28rpx 24rpx;
}

.summary-title {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
}

.summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
  font-size: 24rpx;
}

.summary-row.total {
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.stacked-actions {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 24rpx;
}

.action-row-inline {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  padding: 0 24rpx;
  margin-top: 20rpx;
}

.soft-button,
.warn-button {
  flex: 1;
  min-width: 220rpx;
  height: 84rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
}

.soft-button {
  background: #f7f7f8;
  color: #111111;
}

.warn-button {
  background: #fef2f2;
  color: #b91c1c;
}

.message-board {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 0 24rpx 220rpx;
}

.message {
  display: flex;
  flex-direction: column;
  max-width: 78%;
}

.message.seller,
.message.system {
  align-self: flex-start;
}

.message.buyer {
  align-self: flex-end;
}

.message-bubble {
  border-radius: 24rpx;
  background: #f7f7f8;
  color: #111111;
  padding: 20rpx 22rpx;
  font-size: 26rpx;
  line-height: 1.7;
}

.message.buyer .message-bubble {
  background: #111111;
  color: #ffffff;
}

.message.system .message-bubble {
  background: #e8f6fd;
  color: #0b3558;
}

.message-time {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #9ca3af;
}

.composer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 55;
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.98);
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
}

.composer-input {
  flex: 1;
  min-height: 88rpx;
  max-height: 180rpx;
  border-radius: 24rpx;
  background: #f7f7f8;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  color: #111111;
}

.composer-send {
  width: 132rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: #111111;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
}

.section-header {
  padding: 0 24rpx;
  margin-top: 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.section-heading {
  font-size: 30rpx;
  font-weight: 800;
  color: #111111;
}

.detail-top-gap {
  margin-top: 24rpx;
}

.top-gap-plain {
  margin-top: 22rpx;
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.section-subtitle {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #6b7280;
}

.detail-chip,
.tag-chip {
  background: #ffffff;
  color: #111111;
}

.status-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #111111;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
}

.status-badge.light {
  background: rgba(255, 255, 255, 0.18);
  color: #ffffff;
}

.detail-meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #6b7280;
}

.stat-strip {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  padding: 0 24rpx;
  margin-top: 18rpx;
}

.stat-card {
  padding: 22rpx;
  border-radius: 26rpx;
  background: #f7f7f8;
}

.stat-value {
  font-size: 32rpx;
  font-weight: 800;
  color: #111111;
}

.stat-label {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #6b7280;
}

.market-strip {
  margin: 20rpx 24rpx 0;
  padding: 22rpx 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, rgba(14, 165, 233, 0.08) 0%, rgba(255, 255, 255, 0.96) 100%);
}

.market-note {
  font-size: 23rpx;
  line-height: 1.8;
  color: #4b5563;
}

.market-emphasis {
  color: #111111;
  font-weight: 700;
}

.helper-note {
  margin-top: 12rpx;
  font-size: 21rpx;
  line-height: 1.7;
  color: #94a3b8;
}

.form-label {
  font-size: 22rpx;
  color: #6b7280;
}

.spec-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.spec-row + .spec-row {
  margin-top: 18rpx;
}

.spec-label {
  font-size: 24rpx;
  color: #6b7280;
}

.spec-value {
  max-width: 62%;
  text-align: right;
  font-size: 25rpx;
  line-height: 1.7;
  color: #111111;
  font-weight: 600;
}

.bullet-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.bullet-row + .bullet-row {
  margin-top: 18rpx;
}

.bullet-dot {
  width: 12rpx;
  height: 12rpx;
  margin-top: 14rpx;
  border-radius: 999rpx;
  background: #0ea5e9;
  flex-shrink: 0;
}

.bullet-text {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.8;
  color: #4b5563;
}

.empty-panel {
  padding: 40rpx 32rpx;
  border-radius: 32rpx;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #111111;
}

.empty-copy {
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.8;
  color: #6b7280;
}
