<view class="page-shell">
  <view class="topbar">
    <text class="brand">Discover.</text>
    <view class="topbar-actions">
      <text class="topbar-icon">⌕</text>
    </view>
  </view>

  <view class="hero-panel">
    <view class="hero-tag">分类与院校</view>
    <view class="hero-title small">从研究方向进入平台仪器广场</view>
    <view class="hero-copy">分类页只展示平台市场中正在流通的仪器和管理员维护的认证院校，用于帮助用户完成筛选和认证，不代表是你个人账号已上传的设备。</view>
  </view>

  <view wx:if="{{loading}}" class="loading-state">正在整理分类与院校数据...</view>

  <view wx:else>
    <view class="section-head section">
      <view>
        <view class="section-title">仪器分类</view>
        <view class="section-subtitle">点击后会进入对应分类的在架仪器列表。</view>
      </view>
    </view>

    <view class="feed-list">
      <view class="feed-item" wx:for="{{categories}}" wx:key="*this" data-category="{{item}}" bindtap="openCategory">
        <view class="poster-box square">
          <view class="poster-bg poster-theme-{{(index % 4) + 1}}"></view>
          <view class="poster-content">
            <view class="poster-topline">
              <view class="remote-pill">分类</view>
            </view>
            <view>
              <view class="poster-title">{{item}}</view>
              <view class="poster-meta">查看该方向下的认证仪器与服务</view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="section-head section">
      <view>
        <view class="section-title">认证院校</view>
        <view class="section-subtitle">管理员在后台维护学校和学院列表，认证时从这里联动选择。</view>
      </view>
    </view>

    <view class="section list-stack">
      <view class="card panel" wx:for="{{schools}}" wx:key="id">
        <view class="author-row">
          <view class="author-left">
            <view class="avatar a{{(index % 4) + 1}}"></view>
            <view class="author-meta">
              <view class="author-name-row">
                <text class="author-name">{{item.name}}</text>
                <view class="verify-badge">V</view>
              </view>
              <text class="author-inst">平台认证院校</text>
            </view>
          </view>
        </view>
        <view class="feature-copy">{{item.collegesText}}</view>
      </view>
    </view>
  </view>
</view>
