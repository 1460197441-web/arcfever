<view class="page-shell">
  <view class="nav-row">
    <view class="back-btn" bindtap="goBack">‹</view>
  </view>

  <view wx:if="{{loading}}" class="loading-state">正在加载帖子...</view>

  <block wx:elif="{{post}}">
    <view class="screen-pad">
      <view class="author-row">
        <view class="author-left">
          <view class="avatar a1"></view>
          <view class="author-meta">
            <view class="author-name-row">
              <text class="author-name">{{post.author}}</text>
              <view class="verify-badge">V</view>
            </view>
            <text class="author-inst">平台社区作者</text>
          </view>
        </view>
      </view>
    </view>

    <view class="hero-panel">
      <view class="chip detail-chip">{{post.tag}}</view>
      <view class="hero-title small">{{post.title}}</view>
      <view class="detail-meta">{{post.likes}} 赞 · {{post.comments}} 评论</view>
      <view class="hero-copy">围绕仪器共享、远程实验和真实交易场景沉淀的内容，会长期影响平台的信任感和协作效率。</view>
    </view>

    <view class="section">
      <view class="card post-body">
        <view class="post-content">{{post.content}}</view>
      </view>
    </view>

    <view class="section">
      <view class="section-head">
        <view>
          <view class="section-title">相关文章</view>
          <view class="section-subtitle">继续浏览同主题的社区经验和方法论沉淀。</view>
        </view>
      </view>
      <view class="list-stack">
        <view class="card post-item" wx:for="{{related}}" wx:key="id" data-id="{{item.id}}" bindtap="openPost">
          <view class="chip tag-chip">{{item.tag}}</view>
          <view class="feature-title top-gap">{{item.title}}</view>
          <view class="feature-copy">{{item.excerpt}}</view>
        </view>
      </view>
    </view>
  </block>
</view>
