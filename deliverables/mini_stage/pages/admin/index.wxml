<view class="page-shell">
  <view class="nav-row"><view class="back-btn" bindtap="goBack">‹</view></view>
  <view class="hero-panel">
    <view class="hero-tag">平台管理</view>
    <view class="hero-title">审核、风控、院校维护与纠纷处理</view>
    <view class="hero-copy">这里不再只是一个展示页，而是平台方真实运营的入口：认证审核、举报处理、纠纷处置和认证院校维护都从这里进入。</view>
  </view>
  <view wx:if="{{stats}}" class="section grid-two">
    <view class="card menu-card">
      <view class="feature-title">{{stats.pendingCertification}}</view>
      <view class="feature-copy">待审核认证</view>
    </view>
    <view class="card menu-card">
      <view class="feature-title">{{stats.totalSchools}}</view>
      <view class="feature-copy">认证院校</view>
    </view>
    <view class="card menu-card">
      <view class="feature-title">{{stats.totalInstruments}}</view>
      <view class="feature-copy">在架仪器</view>
    </view>
    <view class="card menu-card">
      <view class="feature-title">{{stats.openDisputes}}</view>
      <view class="feature-copy">纠纷工单</view>
    </view>
    <view class="card menu-card">
      <view class="feature-title">{{stats.openReports}}</view>
      <view class="feature-copy">待处理举报</view>
    </view>
  </view>
  <view class="stacked-actions">
    <view class="primary-btn" data-page="/pages/admin-certifications/index" bindtap="goPage">认证审核</view>
    <view class="light-btn" data-page="/pages/admin-reports/index" bindtap="goPage">举报处理</view>
    <view class="light-btn" data-page="/pages/admin-disputes/index" bindtap="goPage">纠纷工单</view>
    <view class="light-btn" bindtap="goSchoolManage">学校学院维护</view>
  </view>
</view>
