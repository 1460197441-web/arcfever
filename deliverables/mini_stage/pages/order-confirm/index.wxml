<view class="page-shell">
  <view class="nav-row">
    <view class="back-btn" bindtap="goBack">‹</view>
  </view>

  <view class="hero-panel">
    <view class="hero-tag">订单确认</view>
    <view class="hero-title">确认交易模式、风险条款与付款结构</view>
    <view class="hero-copy">这一步我已经改成真实交易流程：协议、保险、押金、损坏责任和交付方式都需要明确确认后才能继续。</view>
  </view>

  <view wx:if="{{loading}}" class="loading-state">正在准备订单...</view>
  <view wx:elif="{{!instrument}}" class="empty-state">当前没有可结算的仪器，请先返回详情页或购物车。</view>

  <view wx:else>
    <view class="screen-pad">
      <view class="author-row">
        <view class="author-left">
          <view class="avatar {{instrument.avatarClass}}"></view>
          <view class="author-meta">
            <view class="author-name-row">
              <text class="author-name">{{instrument.sellerName}}</text>
              <view class="verify-badge {{instrument.verifiedType === 'green' ? 'green' : ''}}">V</view>
            </view>
            <text class="author-inst">{{instrument.school}} / {{instrument.college}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="detail-block">
      <view class="block-card">
        <view class="feature-title">{{instrument.name}}</view>
        <view class="subtle-copy">{{instrument.desc}}</view>

        <view class="row-label top-gap-plain">交易模式</view>
        <view class="option-row">
          <view
            wx:for="{{instrument.tradeModes}}"
            wx:key="*this"
            class="option-pill {{tradeMode === item ? 'active' : ''}}"
            data-mode="{{item}}"
            bindtap="onTradeModeTap"
          >
            {{item}}
          </view>
        </view>

        <view wx:if="{{tradeMode === '租赁'}}">
          <view class="switch-row">
            <view class="switch-copy">
              <view class="row-label">起租日期</view>
              <view class="subtle-copy">{{startDate}}</view>
            </view>
            <picker range="{{instrument.availableDates}}" bindchange="onStartDateChange">
              <view class="soft-button picker-action">调整</view>
            </picker>
          </view>

          <view class="switch-row">
            <view class="switch-copy">
              <view class="row-label">归还日期</view>
              <view class="subtle-copy">{{endDate}}</view>
            </view>
            <picker range="{{instrument.availableDates}}" bindchange="onEndDateChange">
              <view class="soft-button picker-action">调整</view>
            </picker>
          </view>
        </view>

        <view class="switch-row" wx:if="{{instrument.supportInsurance}}">
          <view class="switch-copy">
            <view class="row-label">设备保险</view>
            <view class="subtle-copy">
              {{insuranceAccepted ? selectedInsuranceText : '未启用保险，相关损耗将按协议原责任承担'}}
            </view>
          </view>
          <view class="check-pill {{insuranceAccepted ? 'active' : ''}}" bindtap="toggleInsurance">
            {{insuranceAccepted ? '已选' : '关闭'}}
          </view>
        </view>

        <view wx:if="{{instrument.supportInsurance && insuranceAccepted}}">
          <view class="row-label top-gap-plain">保险方案</view>
          <picker range="{{insurancePlanNames}}" bindchange="onInsurancePlanChange">
            <view class="field-select insurance-select">{{selectedInsuranceText}}</view>
          </picker>
        </view>

        <view class="switch-row">
          <view class="switch-copy">
            <view class="row-label">联系人</view>
            <view class="subtle-copy">{{preview.contactName}} · {{preview.contactPhone}}</view>
          </view>
          <view class="soft-button small-action" bindtap="goAgreement">查看协议</view>
        </view>
      </view>
    </view>

    <view class="info-grid detail-top-gap">
      <view class="info-card">
        <view class="info-label">精度参数</view>
        <view class="info-value">{{instrument.precision}}</view>
      </view>
      <view class="info-card">
        <view class="info-label">交付方式</view>
        <view class="info-value">{{tradeMode === '出售' ? '平台验货与物流交付' : (instrument.remote ? '远程实验排期' : '线下现场交接')}}</view>
      </view>
    </view>

    <view class="detail-block">
      <view class="block-card">
        <view class="row-label">发布方补充违约规则</view>
        <view class="line-list">
          <view class="line-item" wx:for="{{instrument.breachRules}}" wx:key="*this">• {{item}}</view>
        </view>

        <view class="row-label top-gap-plain">发布方补充损坏责任</view>
        <view class="line-list">
          <view class="line-item" wx:for="{{instrument.damageRules}}" wx:key="*this">• {{item}}</view>
        </view>
      </view>
    </view>

    <view class="detail-block">
      <view class="block-card">
        <view class="switch-row">
          <view class="switch-copy">
            <view class="row-label">已阅读平台统一协议</view>
            <view class="subtle-copy">{{preview.agreement.title}}</view>
          </view>
          <view class="check-pill {{agreementAccepted ? 'active' : ''}}" bindtap="toggleAgreement">
            {{agreementAccepted ? '已勾选' : '未勾选'}}
          </view>
        </view>

        <view class="switch-row">
          <view class="switch-copy">
            <view class="row-label">已知悉发布方补充条款</view>
            <view class="subtle-copy">平台会依据聊天记录、验机记录和协议条款处理纠纷</view>
          </view>
          <view class="check-pill {{damageAccepted ? 'active' : ''}}" bindtap="toggleDamage">
            {{damageAccepted ? '已勾选' : '未勾选'}}
          </view>
        </view>

        <view class="row-label top-gap-plain">补充说明</view>
        <textarea class="field-textarea" placeholder="填写取货方式、发票需求、实验排期或物流要求" bindinput="onInput"></textarea>
      </view>
    </view>

    <view class="summary-card">
      <view class="summary-title">支付结构</view>
      <view class="summary-row" wx:if="{{selectedItem.tradeMode === '租赁'}}">
        <text>租金（{{selectedItem.rentDays}} 天）</text>
        <text>¥{{selectedItem.rentalAmount}}</text>
      </view>
      <view class="summary-row" wx:if="{{selectedItem.tradeMode === '出售'}}">
        <text>买断金额</text>
        <text>¥{{selectedItem.saleAmount}}</text>
      </view>
      <view class="summary-row">
        <text>保险费用</text>
        <text>¥{{selectedItem.insuranceFee}}</text>
      </view>
      <view class="summary-row">
        <text>押金</text>
        <text>¥{{selectedItem.deposit}}</text>
      </view>
      <view class="summary-row">
        <text>平台服务费</text>
        <text>¥{{selectedItem.platformServiceFee}}</text>
      </view>
      <view class="summary-row total">
        <text>应付总额</text>
        <text>¥{{preview.total}}</text>
      </view>
    </view>

    <view class="stacked-actions">
      <view class="primary-cta" bindtap="submitOrder">提交并去支付</view>
    </view>
  </view>
</view>
