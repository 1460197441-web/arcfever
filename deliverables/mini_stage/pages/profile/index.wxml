<view class="page-shell">
  <view class="topbar">
    <text class="brand">Profile.</text>
  </view>

  <view wx:if="{{loading}}" class="loading-state">正在加载个人中心...</view>

  <view wx:elif="{{profile}}">
    <view class="screen-pad">
      <view class="author-row">
        <view class="author-left">
          <view class="avatar a1"></view>
          <view class="author-meta">
            <view class="author-name-row">
              <text class="author-name">{{profile.certification.name}}</text>
              <view
                wx:if="{{profile.certification.status === '已认证' || profile.certification.status === '已通过'}}"
                class="verify-badge"
              >
                V
              </view>
            </view>
            <text class="author-inst"
              >{{profile.certification.role}} · {{profile.certification.school || '待选择学校'}} /
              {{profile.certification.college || '待选择学院'}}</text
            >
          </view>
        </view>
      </view>
    </view>

    <view class="hero-copy">{{profile.certification.pendingMessage}}</view>

    <view class="info-grid detail-top-gap">
      <view class="info-card">
        <view class="info-label">联系电话</view>
        <view class="info-value">{{profile.certification.phone || '未填写'}}</view>
      </view>
      <view class="info-card">
        <view class="info-label">机构邮箱</view>
        <view class="info-value">{{profile.certification.email || '未填写'}}</view>
      </view>
      <view class="info-card">
        <view class="info-label">学工号 / 工号</view>
        <view class="info-value">{{profile.certification.instituteId || '未填写'}}</view>
      </view>
      <view class="info-card">
        <view class="info-label">证明文件</view>
        <view class="info-value">{{profile.certification.proofName || '未上传'}}</view>
      </view>
    </view>

    <view class="feed-list">
      <view class="feed-item">
        <view class="poster-box square">
          <view class="poster-bg poster-theme-1"></view>
          <view class="poster-content">
            <view class="poster-topline">
              <view class="remote-pill">{{profile.certification.status}}</view>
            </view>
            <view>
              <view class="poster-title">我的仪器 {{profile.instrumentCount}}</view>
              <view class="poster-meta">订单 {{profile.orderCount}} · 收藏 {{profile.favoriteCount}}</view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="panel-title">个人操作</view>
    <view class="feed-list">
      <view class="feed-item" data-page="/pages/certification/index" bindtap="goPage">
        <view class="desc-block">认证信息</view>
        <view class="time-note">{{profile.certification.status}}</view>
      </view>
      <view class="feed-item" data-page="/pages/my-instruments/index" bindtap="goPage">
        <view class="desc-block">我发布的</view>
        <view class="time-note">管理个人设备</view>
      </view>
      <view class="feed-item" data-page="/pages/order-list/index" bindtap="goPage">
        <view class="desc-block">订单列表</view>
        <view class="time-note">查看交易进度</view>
      </view>
      <view class="feed-item" data-page="/pages/favorite-list/index" bindtap="goPage">
        <view class="desc-block">我的收藏</view>
        <view class="time-note">仪器收藏夹</view>
      </view>
      <view class="feed-item" data-page="/pages/rating-list/index" bindtap="goPage">
        <view class="desc-block">评价管理</view>
        <view class="time-note">沉淀口碑与交易反馈</view>
      </view>
      <view wx:if="{{profile.certification.isAdmin}}" class="feed-item" data-page="/pages/admin/index" bindtap="goPage">
        <view class="desc-block">管理后台</view>
        <view class="time-note">学校学院与审核维护</view>
      </view>
    </view>
  </view>
</view>
