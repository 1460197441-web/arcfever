<view class="page-shell">
  <view class="nav-row"><view class="back-btn" bindtap="goBack">‹</view></view>
  <view class="hero-panel">
    <view class="hero-tag">认证审核</view>
    <view class="hero-title">核验科研身份与机构归属</view>
  </view>
  <view class="section list-stack">
    <view class="card panel" wx:for="{{list}}" wx:key="id">
      <view class="feature-top">
        <view>
          <view class="feature-title">{{item.name}} · {{item.role}}</view>
          <view class="meta-text">{{item.school}} / {{item.college}}</view>
        </view>
        <view class="badge">{{item.status}}</view>
      </view>
      <view class="meta-text">{{item.phone}} · {{item.email}}</view>
      <view class="meta-text">学工号 / 工号：{{item.instituteId}}</view>
      <view class="meta-text">机构证明：{{item.proofName}}</view>
      <view class="meta-text">提交时间：{{item.submittedAt}}</view>
      <view wx:if="{{item.status === '待审核'}}" class="action-row-inline action-inline-no-pad">
        <view class="soft-button" data-id="{{item.id}}" data-status="已驳回" bindtap="review">驳回</view>
        <view class="primary-btn" data-id="{{item.id}}" data-status="已通过" bindtap="review">通过</view>
      </view>
    </view>
  </view>
</view>
