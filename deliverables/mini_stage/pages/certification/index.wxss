.cert-page {
  padding-bottom: 48rpx;
}

.cert-panel {
  padding: 48rpx 36rpx;
  border-radius: 32rpx;
}

.status-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
  margin-bottom: 36rpx;
}

.status-copy {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #6b7280;
}

.group-title {
  margin: 40rpx 0 22rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #111827;
  letter-spacing: 1rpx;
}

.form-group {
  margin-bottom: 34rpx;
}

.form-label {
  margin-bottom: 12rpx;
}

.form-input,
.picker-box {
  min-height: 108rpx;
  padding: 0 32rpx;
  border-radius: 24rpx;
  background: #f8fafc;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #111827;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-input {
  width: 100%;
}

.input-helper {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #94a3b8;
}

.upload-box {
  align-items: center;
  min-height: 164rpx;
  padding-top: 24rpx;
  padding-bottom: 24rpx;
}

.upload-copy {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
}

.upload-title {
  font-size: 28rpx;
  color: #111827;
}

.upload-helper {
  font-size: 22rpx;
  line-height: 1.6;
  color: #94a3b8;
}

.upload-link {
  margin-left: 24rpx;
  color: #0ea5e9;
  font-size: 26rpx;
  font-weight: 700;
}

.action-stack {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 28rpx;
}

.action-btn {
  width: 100%;
  justify-content: center;
  box-sizing: border-box;
}

.minor-action {
  text-align: center;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.8;
  padding: 6rpx 0 4rpx;
}
