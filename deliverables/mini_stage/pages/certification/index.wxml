<view class="page-shell cert-page">
  <view class="nav-row">
    <view class="back-btn" bindtap="goBack">‹</view>
  </view>

  <view class="hero-panel">
    <view class="hero-tag">个人认证</view>
    <view class="hero-title">科研身份认证</view>
    <view class="hero-copy">
      这里只保留一条主操作线：填写资料并提交审核。重置认证不再做成第二个大按钮，避免和返回操作混在一起。
    </view>
  </view>

  <view class="section card panel cert-panel">
    <view class="status-row">
      <view>
        <view class="form-label">当前状态</view>
        <view class="status-copy">认证通过后，才能发布仪器、加入购物车、下单和发起纠纷。</view>
      </view>
      <view class="status-badge">{{status}}</view>
    </view>

    <view class="group-title">身份信息</view>

    <view class="form-group">
      <view class="form-label">姓名</view>
      <input class="form-input" value="{{name}}" placeholder="请输入姓名" data-field="name" bindinput="onInput" />
    </view>

    <view class="form-group">
      <view class="form-label">角色</view>
      <picker range="{{roleNames}}" value="{{roleIndex}}" bindchange="onRoleChange">
        <view class="picker-box">{{roleNames[roleIndex]}}</view>
      </picker>
    </view>

    <view class="form-group">
      <view class="form-label">电话</view>
      <input class="form-input" value="{{phone}}" type="number" placeholder="请输入手机号" data-field="phone" bindinput="onInput" />
    </view>

    <view class="form-group">
      <view class="form-label">邮箱</view>
      <input class="form-input" value="{{email}}" placeholder="请输入机构邮箱" data-field="email" bindinput="onInput" />
      <view class="input-helper">建议填写学校或机构邮箱，方便管理员核验。</view>
    </view>

    <view class="form-group">
      <view class="form-label">学工号 / 工号</view>
      <input class="form-input" value="{{instituteId}}" placeholder="请输入学工号或工号" data-field="instituteId" bindinput="onInput" />
    </view>

    <view class="group-title">机构归属</view>

    <view class="form-group">
      <view class="form-label">学校</view>
      <picker range="{{schoolNames}}" value="{{schoolIndex}}" bindchange="onSchoolChange">
        <view class="picker-box">{{schoolNames[schoolIndex] || '请选择学校'}}</view>
      </picker>
    </view>

    <view class="form-group">
      <view class="form-label">学院</view>
      <picker range="{{collegeNames}}" value="{{collegeIndex}}" bindchange="onCollegeChange">
        <view class="picker-box">{{collegeNames[collegeIndex] || '请选择学院'}}</view>
      </picker>
    </view>

    <view class="group-title">证明材料</view>

    <view class="form-group">
      <view class="form-label">机构证明</view>
      <view class="picker-box upload-box" bindtap="mockUploadProof">
        <view class="upload-copy">
          <text class="upload-title">{{proofName || '点击上传机构证明'}}</text>
          <text class="upload-helper">可使用工牌、实验室证明或院系授权文件。</text>
        </view>
        <text class="upload-link">上传</text>
      </view>
    </view>

    <view class="action-stack">
      <view class="primary-btn action-btn" bindtap="submit">提交认证</view>
      <view class="minor-action" bindtap="resetCertification">清空资料并恢复未认证</view>
    </view>
  </view>
</view>
