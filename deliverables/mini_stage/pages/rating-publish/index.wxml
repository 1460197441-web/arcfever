<view class="page-shell">
  <view class="nav-row">
    <view class="back-btn" bindtap="goBack">‹</view>
  </view>

  <view class="hero-panel">
    <view class="hero-tag">发布评价</view>
    <view class="hero-title small">沉淀交易口碑与仪器可信度</view>
    <view class="hero-copy">评价会进入平台真实口碑体系，影响后续交易信任、仪器曝光和发布方的协作匹配结果。</view>
  </view>

  <view class="section">
    <view class="card panel rating-form-panel">
      <view wx:if="{{orderId}}" class="market-strip inner-note">
        <view class="market-note">当前评价与订单 <text class="market-emphasis">{{orderId}}</text> 关联，提交后会同步写入该交易记录。</view>
      </view>

      <view class="form-label top-gap">评价对象</view>
      <input class="form-input" data-field="target" value="{{target}}" bindinput="onInput" placeholder="填写仪器名称或订单对象" />

      <view class="form-label top-gap">评分</view>
      <input class="form-input" data-field="score" value="{{score}}" bindinput="onInput" placeholder="1-5 分" />

      <view class="form-label top-gap">评价内容</view>
      <textarea class="form-textarea" data-field="content" bindinput="onInput" placeholder="请输入本次交易体验、参数真实性和交付反馈">{{content}}</textarea>

      <view class="primary-btn full-btn top-gap" bindtap="submit">提交评价</view>
    </view>
  </view>
</view>
