<view class="page-shell">
  <view class="nav-row">
    <view class="back-btn" bindtap="goBack">‹</view>
  </view>

  <view class="hero-panel">
    <view class="hero-tag">购物车</view>
    <view class="hero-title">逐台仪器结算，避免租售模式和交付条件混淆</view>
    <view class="hero-copy">我已经把这里改成更真实的平台逻辑：按仪器逐单结算，确认押金、保险、服务费和交付方式后再提交订单。</view>
  </view>

  <view wx:if="{{loading}}" class="loading-state">正在加载购物车...</view>
  <view wx:elif="{{!list.length}}" class="empty-state">购物车还是空的，先去看看仪器吧。</view>

  <view wx:else>
    <view class="section list-stack">
      <view class="card panel" wx:for="{{list}}" wx:key="id">
        <view class="feature-top">
          <view>
            <view class="feature-title" data-id="{{item.instrument.id}}" bindtap="openInstrument">{{item.instrument.name}}</view>
            <view class="meta-text">{{item.instrument.sellerName}} · {{item.instrument.school}}</view>
          </view>
          <view class="badge">{{item.tradeMode}}</view>
        </view>

        <view class="subtle-copy">{{item.instrument.desc}}</view>

        <view class="row-between">
          <text class="row-label">交易价格</text>
          <text class="row-value">{{item.amountLabel}}</text>
        </view>
        <view class="row-between" wx:if="{{item.tradeMode === '租赁'}}">
          <text class="row-label">租期</text>
          <text class="row-value">{{item.dateLabel}}（{{item.rentDays}} 天）</text>
        </view>
        <view class="row-between" wx:if="{{item.tradeMode === '出售'}}">
          <text class="row-label">交付方式</text>
          <text class="row-value">平台验货 + 物流交付</text>
        </view>
        <view class="row-between">
          <text class="row-label">保险</text>
          <text class="row-value">{{item.insuranceAccepted ? item.insurancePlan.name : '未启用保险'}}</text>
        </view>
        <view class="row-between">
          <text class="row-label">押金 / 服务费</text>
          <text class="row-value">¥{{item.deposit}} / ¥{{item.platformServiceFee}}</text>
        </view>
        <view class="row-between">
          <text class="row-label">小计</text>
          <text class="row-value">¥{{item.total}}</text>
        </view>

        <view class="action-row-inline action-inline-no-pad">
          <view class="soft-button" data-id="{{item.id}}" bindtap="removeItem">移除</view>
          <view
            class="primary-btn"
            data-instrument-id="{{item.instrument.id}}"
            data-trade-mode="{{item.tradeMode}}"
            bindtap="goConfirm"
          >
            结算该仪器
          </view>
        </view>
      </view>
    </view>

    <view class="summary-card">
      <view class="summary-title">购物车汇总</view>
      <view class="summary-row">
        <text>保险合计</text>
        <text>¥{{insuranceTotal}}</text>
      </view>
      <view class="summary-row">
        <text>押金合计</text>
        <text>¥{{depositTotal}}</text>
      </view>
      <view class="summary-row">
        <text>平台服务费</text>
        <text>¥{{serviceTotal}}</text>
      </view>
      <view class="summary-row total">
        <text>待支付总额</text>
        <text>¥{{total}}</text>
      </view>
    </view>
  </view>
</view>
