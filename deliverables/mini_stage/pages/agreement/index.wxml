<view class="page-shell">
  <view class="nav-row"><view class="back-btn" bindtap="goBack">‹</view></view>
  <view wx:if="{{!agreement}}" class="loading-state">正在加载协议...</view>
  <view wx:else>
    <view class="hero-panel">
      <view class="hero-tag">平台统一协议</view>
      <view class="hero-title">{{agreement.title}}</view>
      <view class="hero-copy">{{agreement.version}} · {{agreement.summary}}</view>
    </view>

    <view wx:if="{{instrument}}" class="detail-block">
      <view class="block-card">
        <view class="feature-title">{{instrument.name}}</view>
        <view class="meta-text">{{instrument.school}} · {{instrument.sellerName}}</view>
        <view class="row-between">
          <text class="row-label">租赁日价</text>
          <text class="row-value">{{instrument.priceLabel}}</text>
        </view>
        <view class="row-between">
          <text class="row-label">买断价格</text>
          <text class="row-value">{{instrument.salePriceLabel}}</text>
        </view>
        <view class="row-between">
          <text class="row-label">押金</text>
          <text class="row-value">¥{{instrument.deposit}}</text>
        </view>
      </view>
    </view>

    <view class="detail-block">
      <view class="block-card">
        <view class="row-label">平台统一协议条款</view>
        <view class="line-list">
          <view class="line-item" wx:for="{{agreement.items}}" wx:key="*this">• {{item}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{instrument}}" class="detail-block">
      <view class="block-card">
        <view class="row-label">发布方补充违约规则</view>
        <view class="line-list">
          <view class="line-item" wx:for="{{instrument.breachRules}}" wx:key="*this">• {{item}}</view>
        </view>
        <view class="row-label top-gap-plain">发布方补充损坏责任</view>
        <view class="subtle-copy">以下条款由设备发布方填写，平台展示并留痕，用于交易确认与纠纷处理。</view>
        <view class="line-list">
          <view class="line-item" wx:for="{{instrument.damageRules}}" wx:key="index">• {{item}}</view>
        </view>
      </view>
    </view>
  </view>
</view>
