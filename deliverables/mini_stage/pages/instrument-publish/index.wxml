<view class="page-shell">
  <view class="topbar">
    <text class="brand">Publish.</text>
  </view>

  <view class="hero-copy">
    这版发布页已经按真实交易场景补齐了租售模式、价格、押金、精度、数据服务、违约与损坏说明，让平台具备“像闲鱼一样可发布，可租赁，也可出售”的基础能力。
  </view>

  <view class="form-wrap">
    <view class="field-label">仪器名称</view>
    <input class="field-input" data-field="name" bindinput="onInput" placeholder="请输入仪器名称" />

    <view class="field-label">分类</view>
    <picker range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
      <view class="field-select">{{categories[categoryIndex] || '请选择分类'}}</view>
    </picker>

    <view class="field-label">交易模式</view>
    <view class="option-row">
      <view
        wx:for="{{tradeModeOptions}}"
        wx:key="value"
        class="option-pill {{item.selected ? 'active' : ''}}"
        data-mode="{{item.value}}"
        bindtap="toggleTradeMode"
      >
        {{item.value}}
      </view>
    </view>

    <view class="field-label">租赁日价</view>
    <input class="field-input" data-field="price" bindinput="onInput" placeholder="请输入价格 / 天" />

    <view class="field-label">买断价格</view>
    <input class="field-input" data-field="salePrice" bindinput="onInput" placeholder="若支持出售，请填写买断价格" />

    <view class="field-label">押金</view>
    <input class="field-input" data-field="deposit" bindinput="onInput" placeholder="租赁场景建议填写押金" />

    <view class="field-label">所在城市</view>
    <input class="field-input" data-field="location" bindinput="onInput" placeholder="请输入城市与交接区域" />

    <view class="field-label">精度参数</view>
    <input class="field-input" data-field="precision" bindinput="onInput" placeholder="例如：误差小于 2 kPa / 分辨率 0.01 mm" />

    <view class="field-label">适用学科</view>
    <input class="field-input" data-field="disciplines" bindinput="onInput" placeholder="多个学科可用“、”分隔" />

    <view class="field-label">服务包说明</view>
    <input class="field-input" data-field="servicePackage" bindinput="onInput" placeholder="例如：附带标准数据包与处理代码" />

    <view class="switch-row">
      <view class="switch-copy">
        <view class="field-label no-gap">附带数据处理代码</view>
        <view class="subtle-copy">把设备租赁和数据服务打包成更完整的科研交付能力</view>
      </view>
      <view class="check-pill {{form.withDataPackage ? 'active' : ''}}" data-field="withDataPackage" bindtap="toggleFlag">
        {{form.withDataPackage ? '是' : '否'}}
      </view>
    </view>

    <view class="switch-row">
      <view class="switch-copy">
        <view class="field-label no-gap">支持远程实验</view>
        <view class="subtle-copy">适合高校 / 机构共建、远程值守和真实科研服务交付</view>
      </view>
      <view class="check-pill {{form.remote ? 'active' : ''}}" data-field="remote" bindtap="toggleFlag">
        {{form.remote ? '是' : '否'}}
      </view>
    </view>

    <view class="field-label">科研描述</view>
    <textarea class="field-textarea" data-field="desc" bindinput="onInput" placeholder="说明设备适用方向、应用场景、交付内容与约束条件"></textarea>

    <view class="field-label">违约规则</view>
    <textarea class="field-textarea" data-field="breachRulesText" bindinput="onInput" placeholder="建议逐行填写，例如：超时归还按日租金 10% 收取违约金"></textarea>

    <view class="field-label">损坏责任</view>
    <textarea class="field-textarea" data-field="damageRulesText" bindinput="onInput" placeholder="建议逐行填写，例如：人为损坏按维修报价赔付"></textarea>
  </view>

  <view class="stacked-actions">
    <view class="primary-cta" bindtap="submit">确认发布</view>
  </view>
</view>
