<view class="page-shell">
  <view class="nav-row">
    <view class="back-btn" bindtap="goBack">‹</view>
  </view>

  <view class="hero-panel">
    <view class="hero-tag">科研社区</view>
    <view class="hero-title small">仪器经验、协作记录与真实交流</view>
    <view class="hero-copy">围绕仪器共享、远程实验、数据交付和平台风控沉淀真实讨论，让内容看起来也像平台的一部分。</view>
  </view>

  <view class="section">
    <view class="chip-row">
      <view
        wx:for="{{tags}}"
        wx:key="*this"
        class="chip {{activeTag === item ? 'active' : ''}}"
        data-tag="{{item}}"
        bindtap="chooseTag"
      >
        {{item}}
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading-state">正在获取社区内容...</view>
  <view wx:elif="{{!filteredList.length}}" class="empty-state">当前标签下还没有内容。</view>

  <view wx:else class="section list-stack">
    <view class="card post-item" wx:for="{{filteredList}}" wx:key="id" data-id="{{item.id}}" bindtap="openPost">
      <view class="chip tag-chip">{{item.tag}}</view>
      <view class="feature-title">{{item.title}}</view>
      <view class="feature-copy">{{item.excerpt}}</view>
      <view class="post-meta">{{item.author}} · {{item.likes}} 赞 · {{item.comments}} 评论</view>
    </view>
  </view>
</view>
