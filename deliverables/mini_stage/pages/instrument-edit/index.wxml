<view class="page-shell">
  <view class="nav-row">
    <view class="back-btn" bindtap="goBack">‹</view>
  </view>

  <view wx:if="{{!instrument}}" class="loading-state">正在加载仪器信息...</view>

  <view wx:else>
    <view class="hero-panel">
      <view class="hero-tag">编辑仪器</view>
      <view class="hero-title">{{instrument.name}}</view>
      <view class="hero-copy">{{instrument.category}} · {{instrument.school}} / {{instrument.college}}</view>
    </view>

    <view class="form-wrap">
      <view class="field-label">交易模式</view>
      <view class="option-row">
        <view
          wx:for="{{tradeModeOptions}}"
          wx:key="value"
          class="option-pill {{item.selected ? 'active' : ''}}"
          data-mode="{{item.value}}"
          bindtap="toggleTradeMode"
        >
          {{item.value}}
        </view>
      </view>

      <view class="field-label">租赁日价</view>
      <input class="field-input" value="{{form.price}}" data-field="price" bindinput="onInput" />

      <view class="field-label">买断价格</view>
      <input class="field-input" value="{{form.salePrice}}" data-field="salePrice" bindinput="onInput" />

      <view class="field-label">押金</view>
      <input class="field-input" value="{{form.deposit}}" data-field="deposit" bindinput="onInput" />

      <view class="field-label">交接城市</view>
      <input class="field-input" value="{{form.location}}" data-field="location" bindinput="onInput" />

      <view class="field-label">精度参数</view>
      <input class="field-input" value="{{form.precision}}" data-field="precision" bindinput="onInput" />

      <view class="field-label">适用学科</view>
      <input class="field-input" value="{{form.disciplines}}" data-field="disciplines" bindinput="onInput" />

      <view class="field-label">服务包说明</view>
      <input class="field-input" value="{{form.servicePackage}}" data-field="servicePackage" bindinput="onInput" />

      <view class="switch-row">
        <view class="switch-copy">
          <view class="field-label no-gap">附带数据代码</view>
          <view class="subtle-copy">用于增强设备 + 数据服务的一体化交付能力</view>
        </view>
        <view class="check-pill {{form.withDataPackage ? 'active' : ''}}" data-field="withDataPackage" bindtap="toggleFlag">
          {{form.withDataPackage ? '是' : '否'}}
        </view>
      </view>

      <view class="switch-row">
        <view class="switch-copy">
          <view class="field-label no-gap">支持远程实验</view>
          <view class="subtle-copy">开启后适合排期值守与远程协同</view>
        </view>
        <view class="check-pill {{form.remote ? 'active' : ''}}" data-field="remote" bindtap="toggleFlag">
          {{form.remote ? '是' : '否'}}
        </view>
      </view>

      <view class="field-label">科研描述</view>
      <textarea class="field-textarea" data-field="desc" bindinput="onInput">{{form.desc}}</textarea>

      <view class="field-label">违约规则</view>
      <textarea class="field-textarea" data-field="breachRulesText" bindinput="onInput">{{form.breachRulesText}}</textarea>

      <view class="field-label">损坏责任</view>
      <textarea class="field-textarea" data-field="damageRulesText" bindinput="onInput">{{form.damageRulesText}}</textarea>
    </view>

    <view class="stacked-actions">
      <view class="primary-cta" bindtap="submit">保存修改</view>
    </view>
  </view>
</view>
