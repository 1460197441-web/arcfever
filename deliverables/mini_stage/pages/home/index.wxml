<view class="page-shell">
  <view class="topbar">
    <text class="brand">Synaptic.</text>
    <view class="topbar-actions">
      <text class="topbar-icon">⌕</text>
    </view>
  </view>

  <scroll-view scroll-x class="h-scroll">
    <view
      class="tag-pill {{index === 0 ? 'active' : ''}}"
      wx:for="{{categories}}"
      wx:key="*this"
      data-category="{{item}}"
      bindtap="openCategory"
    >
      {{item}}
    </view>
  </scroll-view>

  <view wx:if="{{loading}}" class="loading-state">正在生成首页内容...</view>

  <view wx:elif="{{homeData}}">
    <view class="panel-title">{{homeData.hero.title}}</view>
    <view class="hero-copy">{{homeData.hero.subtitle}}</view>

    <view class="stat-strip">
      <view class="stat-card" wx:for="{{homeData.stats}}" wx:key="label">
        <view class="stat-value">{{item.value}}</view>
        <view class="stat-label">{{item.label}}</view>
      </view>
    </view>

    <view class="market-strip">
      <view class="market-note">
        <text class="market-emphasis">当前首页展示的是平台广场里的在架仪器。</text>
        它们属于平台冷启动库存或其他认证用户发布，不代表你自己的账号已经上传过设备。
      </view>
    </view>

    <view class="feed-list">
      <view class="feed-item" wx:for="{{homeData.featuredInstruments}}" wx:key="id" data-id="{{item.id}}">
        <view class="author-row">
          <view class="author-left">
            <view class="avatar a{{(index % 4) + 1}}"></view>
            <view class="author-meta">
              <view class="author-name-row">
                <text class="author-name">{{item.sellerName}}</text>
                <view class="verify-badge {{index % 2 === 0 ? '' : 'green'}}">V</view>
              </view>
              <text class="author-inst">{{item.school}} / {{item.college}}</text>
            </view>
          </view>
          <text class="menu-dot">⋯</text>
        </view>

        <view class="poster-box" data-id="{{item.id}}" bindtap="openInstrument">
          <view class="poster-bg poster-theme-{{(index % 4) + 1}}"></view>
          <view class="poster-content">
            <view class="poster-topline">
              <view wx:if="{{item.remote}}" class="remote-pill">支持远程实验</view>
              <view class="price-chip">¥{{item.price}} /天</view>
            </view>
            <view>
              <view class="poster-title">{{item.name}}</view>
              <view class="poster-meta">{{item.location}} · {{item.category}}</view>
            </view>
          </view>
        </view>

        <view class="post-actions">
          <view class="action-group">
            <text class="action-icon">♡</text>
            <text class="action-icon">◌</text>
            <text class="action-icon">↗</text>
          </view>
        </view>

        <view class="desc-block">
          <text class="desc-strong">{{item.sellerName}}</text>
          <text>{{item.desc}}</text>
        </view>

        <view class="micro-note">
          <text>⌘</text>
          <text>{{item.withDataPackage ? item.servicePackage : (item.remote ? '支持远程实验排期与交接' : '支持线下交接与平台风控保障')}}</text>
        </view>

        <text class="time-note">2 小时前 · {{item.location}}</text>
      </view>
    </view>
  </view>
</view>
