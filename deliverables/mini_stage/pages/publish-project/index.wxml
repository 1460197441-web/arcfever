<view class="page-shell">
  <view class="nav-row">
    <view class="back-btn" bindtap="goBack">‹</view>
  </view>

  <view class="hero-panel">
    <view class="hero-tag">发布项目</view>
    <view class="hero-title small">发布科研协作需求</view>
    <view class="hero-copy">面向企业、实验室和项目负责人，快速描述技术目标、预算和合作周期，平台会基于人才评估体系进行初步撮合。</view>
  </view>

  <view class="market-strip">
    <view class="market-note">
      <text class="market-emphasis">创业版建议：</text>
      项目需求尽量写清交付标准、关键实验条件和阶段验收节点，后续更容易做撮合、签约和争议追溯。
    </view>
  </view>

  <view class="section">
    <view class="card panel">
      <view class="section-title">项目信息</view>

      <view class="form-label top-gap">项目标题</view>
      <input class="form-input" placeholder="例如：近岸观测数据建模项目" data-field="title" bindinput="onInput" />

      <view class="form-label top-gap">发起单位</view>
      <input class="form-input" placeholder="填写企业或机构名称" data-field="company" bindinput="onInput" />

      <view class="form-label top-gap">研究领域</view>
      <input class="form-input" placeholder="海洋、地质、材料、平台建设等" data-field="domain" bindinput="onInput" />

      <view class="form-label top-gap">预算区间</view>
      <input class="form-input" placeholder="例如：10-20 万" data-field="budget" bindinput="onInput" />

      <view class="form-label top-gap">期望周期</view>
      <input class="form-input" placeholder="例如：3 个月" data-field="duration" bindinput="onInput" />

      <view class="form-label top-gap">核心需求</view>
      <textarea class="form-textarea" placeholder="描述技术目标、交付标准、协作方式" data-field="needs" bindinput="onInput"></textarea>

      <view class="primary-btn full-btn top-gap" bindtap="submitProject">提交项目</view>
    </view>
  </view>
</view>
