<view class="page-shell">
  <view class="nav-row"><view class="back-btn" bindtap="goBack">‹</view></view>
  <view class="hero-panel">
    <view class="hero-tag">举报处理</view>
    <view class="hero-title">核查异常发布与资质问题</view>
  </view>
  <view class="section list-stack">
    <view class="card panel" wx:for="{{list}}" wx:key="id">
      <view class="feature-top">
        <view>
          <view class="feature-title">{{item.targetType}} · {{item.targetName}}</view>
          <view class="meta-text">举报人：{{item.reporter}}</view>
        </view>
        <view class="badge">{{item.status}}</view>
      </view>
      <view class="feature-copy">{{item.reason}}</view>
      <view wx:if="{{item.status === '待处理'}}" class="stacked-actions short-actions">
        <view class="primary-btn" data-id="{{item.id}}" bindtap="resolve">标记已处理</view>
      </view>
    </view>
  </view>
</view>
