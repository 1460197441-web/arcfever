<view class="page-shell">
  <view class="topbar">
    <text class="topbar-icon" bindtap="goBack">‹</text>
    <text class="brand">Instrument.</text>
    <view class="topbar-actions">
      <text class="topbar-icon" bindtap="reportInstrument">!</text>
      <text class="topbar-icon" bindtap="toggleFavorite">{{isFavorite ? '♥' : '♡'}}</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading-state">正在加载仪器详情...</view>

  <view wx:elif="{{instrument}}">
    <view class="screen-pad">
      <view class="author-row">
        <view class="author-left">
          <view class="avatar {{instrument.avatarClass}}"></view>
          <view class="author-meta">
            <view class="author-name-row">
              <text class="author-name">{{instrument.sellerName}}</text>
              <view class="verify-badge {{instrument.verifiedType === 'green' ? 'green' : ''}}">V</view>
            </view>
            <text class="author-inst">{{instrument.school}} / {{instrument.college}}</text>
          </view>
        </view>
        <text class="author-inst">{{instrument.sellerRole}}</text>
      </view>
    </view>

    <view class="feed-item">
      <view class="poster-box">
        <view class="poster-bg {{instrument.posterTheme}}"></view>
        <view class="poster-content">
          <view class="poster-topline">
            <view class="remote-pill">{{previewItem ? previewItem.tradeMode : instrument.defaultTradeMode}}</view>
            <view class="price-chip">{{previewItem ? previewItem.amountLabel : instrument.priceLabel}}</view>
          </view>
          <view>
            <view class="poster-title">{{instrument.name}}</view>
            <view class="poster-meta">{{instrument.location}} · {{instrument.condition}}</view>
          </view>
        </view>
      </view>

      <view class="post-actions">
        <view class="action-group">
          <text class="action-icon" bindtap="toggleFavorite">{{isFavorite ? '♥' : '♡'}}</text>
          <text class="action-icon" bindtap="goChat">◌</text>
          <text class="action-icon" bindtap="reportInstrument">!</text>
        </view>
        <view class="price-chip">合计 ¥{{previewTotal}}</view>
      </view>

      <view class="desc-block">
        <text class="desc-strong">{{instrument.sellerName}}</text>
        <text>{{instrument.desc}}</text>
      </view>

      <view class="micro-note">
        <text>⌘</text>
        <text>{{instrument.servicePackage}}</text>
      </view>

      <text class="time-note">认证机构 {{instrument.school}} · 联系电话 {{instrument.phone}}</text>
    </view>

    <view class="section-header">
      <text class="section-heading">交易设定</text>
      <text class="inline-link" bindtap="goAgreement">查看平台协议</text>
    </view>

    <view class="detail-block">
      <view class="block-card">
        <view class="row-label">交易模式</view>
        <view class="option-row">
          <view
            wx:for="{{instrument.tradeModes}}"
            wx:key="*this"
            class="option-pill {{tradeMode === item ? 'active' : ''}}"
            data-mode="{{item}}"
            bindtap="onTradeModeTap"
          >
            {{item}}
          </view>
        </view>

        <view wx:if="{{tradeMode === '租赁'}}" class="date-block">
          <view class="switch-row">
            <view class="switch-copy">
              <view class="row-label">起租日期</view>
              <view class="subtle-copy">{{startDate}}</view>
            </view>
            <picker range="{{instrument.availableDates}}" bindchange="onStartDateChange">
              <view class="soft-button picker-action">调整</view>
            </picker>
          </view>

          <view class="switch-row">
            <view class="switch-copy">
              <view class="row-label">归还日期</view>
              <view class="subtle-copy">{{endDate}}</view>
            </view>
            <picker range="{{instrument.availableDates}}" bindchange="onEndDateChange">
              <view class="soft-button picker-action">调整</view>
            </picker>
          </view>
        </view>

        <view class="switch-row" wx:if="{{instrument.supportInsurance}}">
          <view class="switch-copy">
            <view class="row-label">设备保险</view>
            <view class="subtle-copy">
              {{insuranceAccepted ? '已启用，运输与部件损耗可按保单处理' : '未启用，默认自行承担相关风险'}}
            </view>
          </view>
          <view class="check-pill {{insuranceAccepted ? 'active' : ''}}" bindtap="toggleInsurance">
            {{insuranceAccepted ? '已选' : '关闭'}}
          </view>
        </view>

        <view wx:if="{{instrument.supportInsurance && insuranceAccepted}}">
          <view class="row-label top-gap-plain">保单方案</view>
          <picker range="{{insurancePlanNames}}" bindchange="onInsurancePlanChange">
            <view class="field-select insurance-select">
              {{selectedInsuranceText}}
            </view>
          </picker>
        </view>
      </view>
    </view>

    <view class="info-grid detail-top-gap">
      <view class="info-card">
        <view class="info-label">精度参数</view>
        <view class="info-value">{{instrument.precision}}</view>
      </view>
      <view class="info-card">
        <view class="info-label">适用学科</view>
        <view class="info-value">{{instrument.disciplinesText}}</view>
      </view>
      <view class="info-card">
        <view class="info-label">数据与代码</view>
        <view class="info-value">{{instrument.withDataPackage ? '附带标准数据与处理代码' : '仅提供设备使用说明'}}</view>
      </view>
      <view class="info-card">
        <view class="info-label">远程实验</view>
        <view class="info-value">{{instrument.remote ? '支持远程实验协作' : '仅支持线下交接'}}</view>
      </view>
    </view>

    <view class="detail-block">
      <view class="block-card">
        <view class="row-between">
          <text class="row-label">租赁日价</text>
          <text class="row-value">{{instrument.priceLabel}}</text>
        </view>
        <view class="row-between">
          <text class="row-label">买断价格</text>
          <text class="row-value">{{instrument.salePriceLabel}}</text>
        </view>
        <view class="row-between">
          <text class="row-label">押金</text>
          <text class="row-value">¥{{instrument.deposit}}</text>
        </view>
        <view class="row-between">
          <text class="row-label">平台服务费</text>
          <text class="row-value">¥{{instrument.platformServiceFee}}</text>
        </view>
      </view>
    </view>

    <view class="section-header">
      <text class="section-heading">平台协议与发布方条款</text>
    </view>

    <view class="detail-block">
      <view class="block-card">
        <view class="row-label">发布方补充违约规则</view>
        <view class="line-list">
          <view class="line-item" wx:for="{{instrument.breachRules}}" wx:key="*this">• {{item}}</view>
        </view>

        <view class="row-label top-gap-plain">发布方补充损坏责任</view>
        <view class="line-list">
          <view class="line-item" wx:for="{{instrument.damageRules}}" wx:key="*this">• {{item}}</view>
        </view>

        <view class="row-label top-gap-plain">平台统一协议摘要</view>
        <view class="subtle-copy">{{agreement.summary}}</view>
      </view>
    </view>

    <view class="action-row-inline">
      <view class="soft-button" bindtap="goAgreement">查看平台统一协议</view>
      <view class="warn-button" bindtap="reportInstrument">举报信息</view>
    </view>

    <view class="cta-row">
      <view class="secondary-cta" bindtap="addToCart">加入购物车</view>
      <view class="primary-cta" bindtap="buyNow">立即下单</view>
    </view>

    <view class="section-header">
      <text class="section-heading">相关推荐</text>
    </view>

    <view class="feed-list compact-feed">
      <view class="feed-item" wx:for="{{recommendations}}" wx:key="id" data-id="{{item.id}}" bindtap="openInstrument">
        <view class="author-row">
          <view class="author-left">
            <view class="avatar {{item.avatarClass}}"></view>
            <view class="author-meta">
              <view class="author-name-row">
                <text class="author-name">{{item.sellerName}}</text>
                <view class="verify-badge {{item.verifiedType === 'green' ? 'green' : ''}}">V</view>
              </view>
              <text class="author-inst">{{item.school}}</text>
            </view>
          </view>
        </view>
        <view class="desc-block">{{item.name}}</view>
        <text class="time-note">{{item.priceLabel}} · {{item.salePriceLabel}}</text>
      </view>
    </view>
  </view>
</view>
