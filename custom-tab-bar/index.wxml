<view class="tab-shell">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab-item {{selected === index ? 'active' : ''}} {{item.key === 'publish' ? 'center-item' : ''}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <view wx:if="{{item.key === 'home'}}" class="icon-home {{selected === index ? 'active' : ''}}">
      <view class="home-roof"></view>
      <view class="home-body"></view>
    </view>

    <view wx:elif="{{item.key === 'category'}}" class="icon-compass {{selected === index ? 'active' : ''}}">
      <view class="compass-ring"></view>
      <view class="compass-dot"></view>
    </view>

    <view wx:elif="{{item.key === 'publish'}}" class="center-plus {{selected === index ? 'active' : ''}}">+</view>

    <view wx:elif="{{item.key === 'chat'}}" class="icon-chat {{selected === index ? 'active' : ''}}">
      <view class="chat-box"></view>
      <view class="chat-tail"></view>
    </view>

    <view wx:else class="icon-user {{selected === index ? 'active' : ''}}">
      <view class="user-head"></view>
      <view class="user-body"></view>
    </view>

    <text class="tab-text">{{item.text}}</text>
  </view>
</view>
