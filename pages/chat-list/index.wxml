<view class="page-shell">
  <view class="topbar">
    <text class="brand">Messages.</text>
  </view>

  <view class="hero-panel">
    <view class="hero-tag">消息中心</view>
    <view class="hero-title small">查看设备沟通、排期确认与平台介入进度</view>
    <view class="hero-copy">会话页统一承接仪器咨询、订单确认、保险和纠纷前沟通，关键信息都会在这里留痕。</view>
  </view>

  <view wx:if="{{loading}}" class="loading-state">正在同步会话列表...</view>

  <view wx:elif="{{!list.length}}" class="section chat-empty-shell">
    <view class="card panel empty-panel">
      <view class="chat-empty-icon">◌</view>
      <view class="empty-title">还没有会话记录</view>
      <view class="empty-copy">当你从仪器详情页发起咨询、下单后联系发布方，或者平台客服介入时，这里会出现完整会话。</view>
    </view>
  </view>

  <view wx:else class="section list-stack chat-list-stack">
    <view class="card panel chat-card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="openChat">
      <view class="author-row">
        <view class="author-left">
          <view class="avatar a{{(index % 4) + 1}}"></view>
          <view class="author-meta">
            <view class="author-name-row">
              <text class="author-name">{{item.counterpartName || item.sellerName}}</text>
              <view class="verify-badge">V</view>
            </view>
            <text class="author-inst">{{item.counterpartRole || item.sellerRole}} · {{item.instrumentName}}</text>
          </view>
        </view>
        <text class="author-inst">{{item.updatedAt}}</text>
      </view>

      <view class="feature-copy">{{item.lastMessage}}</view>
      <view class="chat-helper-copy">
        {{item.supportIntervened ? '平台客服已介入该会话，可继续在详情页同步争议进度。' : '当前仍为买卖双方直接沟通。'}}
      </view>
    </view>
  </view>
</view>
