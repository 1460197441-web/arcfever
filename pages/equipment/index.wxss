.compact-hero {
  padding: 30rpx;
}

.small-title {
  font-size: 40rpx;
}

.instrument-card {
  padding: 32rpx;
}

.floating-cart {
  position: fixed;
  right: 24rpx;
  bottom: 48rpx;
  padding: 0 30rpx;
  min-height: 88rpx;
  border-radius: 999rpx;
  background:
    radial-gradient(circle at 80% 20%, rgba(14, 165, 233, 0.22), transparent 22%),
    linear-gradient(145deg, #06080d 0%, #0f1724 58%, #151d2a 100%);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  box-shadow: 0 20rpx 40rpx rgba(15, 23, 42, 0.22);
}
