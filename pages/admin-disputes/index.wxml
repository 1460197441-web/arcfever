<view class="page-shell">
  <view class="nav-row"><view class="back-btn" bindtap="goBack">‹</view></view>
  <view class="hero-panel">
    <view class="hero-tag">纠纷工单</view>
    <view class="hero-title">处理交易争议与赔付责任</view>
  </view>

  <view wx:if="{{!list.length}}" class="section">
    <view class="card panel empty-panel">
      <view class="empty-title">当前没有处理中纠纷</view>
      <view class="empty-copy">当买卖双方发起争议后，这里会同步显示关联订单与责任客服。</view>
    </view>
  </view>

  <view wx:else class="section list-stack">
    <view class="card panel" wx:for="{{list}}" wx:key="id">
      <view class="feature-top">
        <view>
          <view class="feature-title">{{item.orderId}}</view>
          <view class="meta-text">责任客服：{{item.assignee}}</view>
        </view>
        <view class="badge">{{item.status}}</view>
      </view>
      <view class="feature-copy">{{item.summary}}</view>
      <view wx:if="{{item.status !== '已结案'}}" class="stacked-actions short-actions">
        <view class="primary-btn" data-id="{{item.id}}" bindtap="resolve">结案</view>
      </view>
    </view>
  </view>
</view>
