.home-page {
  padding-bottom: 180rpx;
}

.home-intro-card {
  margin: 18rpx 24rpx 0;
  padding: 30rpx;
  border-radius: 32rpx;
  background:
    radial-gradient(circle at 84% 18%, rgba(14, 165, 233, 0.18), transparent 18%),
    linear-gradient(145deg, #06080d 0%, #0f1724 58%, #151d2a 100%);
  box-shadow: 0 24rpx 48rpx rgba(15, 23, 42, 0.16);
}

.home-intro-kicker {
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: rgba(255, 255, 255, 0.62);
  text-transform: uppercase;
}

.home-intro-title {
  margin-top: 16rpx;
  font-size: 42rpx;
  line-height: 1.28;
  font-weight: 800;
  color: #ffffff;
}

.home-intro-copy {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.8;
  color: rgba(255, 255, 255, 0.74);
}

.home-stats {
  margin-top: 20rpx;
}
