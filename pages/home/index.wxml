<view class="page-shell home-page">
  <view class="topbar">
    <text class="brand">Synaptic.</text>
    <view class="topbar-actions">
      <text class="topbar-icon">⌕</text>
    </view>
  </view>

  <scroll-view scroll-x class="h-scroll">
    <view
      class="tag-pill {{index === 0 ? 'active' : ''}}"
      wx:for="{{categories}}"
      wx:key="*this"
      data-category="{{item}}"
      bindtap="openCategory"
    >
      {{item}}
    </view>
  </scroll-view>

  <view wx:if="{{loading}}" class="loading-state">正在加载首页内容...</view>

  <view wx:elif="{{homeData}}">
    <view class="home-intro-card">
      <view class="home-intro-kicker">科研仪器共享网络</view>
      <view class="home-intro-title">{{homeData.hero.title}}</view>
      <view class="home-intro-copy">{{homeData.hero.subtitle}}</view>
    </view>

    <view class="stat-strip home-stats">
      <view class="stat-card" wx:for="{{homeData.stats}}" wx:key="label">
        <view class="stat-value">{{item.value}}</view>
        <view class="stat-label">{{item.label}}</view>
      </view>
    </view>

    <view wx:if="{{homeData.featuredInstruments.length}}" class="feed-list">
      <view class="feed-item" wx:for="{{homeData.featuredInstruments}}" wx:key="id" data-id="{{item.id}}">
        <view class="author-row">
          <view class="author-left">
            <view class="avatar a{{(index % 4) + 1}}"></view>
            <view class="author-meta">
              <view class="author-name-row">
                <text class="author-name">{{item.sellerName}}</text>
                <view class="verify-badge {{index % 2 === 0 ? '' : 'green'}}">V</view>
              </view>
              <text class="author-inst">{{item.school}} / {{item.college}}</text>
            </view>
          </view>
          <text class="menu-dot">⋯</text>
        </view>

        <view class="poster-box" data-id="{{item.id}}" bindtap="openInstrument">
          <block wx:if="{{item.coverImage}}">
            <image class="poster-image" src="{{item.coverImage}}" mode="aspectFill"></image>
            <view class="poster-image-mask"></view>
          </block>
          <block wx:else>
            <view class="poster-bg poster-theme-{{(index % 4) + 1}}"></view>
          </block>

          <view class="poster-content">
            <view class="poster-topline">
              <view wx:if="{{item.remote}}" class="remote-pill">支持远程实验</view>
              <view wx:else class="remote-pill">认证发布</view>
              <view class="price-chip">{{item.priceLabel}}</view>
            </view>
            <view>
              <view class="poster-title">{{item.name}}</view>
              <view class="poster-meta">{{item.location}} · {{item.category}}</view>
            </view>
          </view>
        </view>

        <view class="post-actions">
          <view class="action-group">
            <text class="action-icon">♡</text>
            <text class="action-icon">⌁</text>
            <text class="action-icon">↗</text>
          </view>
        </view>

        <view class="desc-block">
          <text class="desc-strong">{{item.sellerName}}</text>
          <text>{{item.desc}}</text>
        </view>

        <view class="micro-note">
          <text>◦</text>
          <text>{{item.withDataPackage ? item.servicePackage : (item.remote ? '支持远程实验排期与数据交付' : '支持线下交接与平台风控保障')}}</text>
        </view>

        <text class="time-note">认证机构 · {{item.school}} · {{item.location}}</text>
      </view>
    </view>

    <view wx:else class="section">
      <view class="card panel empty-panel">
        <view class="empty-title">还没有人在平台发布仪器</view>
        <view class="empty-copy">等认证用户上传真实设备后，这里会展示最新的仪器、数据服务和远程实验能力。</view>
      </view>
    </view>
  </view>
</view>
