<view class="page-shell">
  <view class="nav-row">
    <view class="back-btn" bindtap="goBack">‹</view>
  </view>

  <view class="hero-panel">
    <view class="hero-tag">我的仪器</view>
    <view class="hero-title">管理你自己发布的设备</view>
    <view class="hero-copy">这里只有你自己发布的仪器。未认证状态下不会出现任何可编辑设备，也不会再用示例数据占位。</view>
    <view class="hero-actions">
      <view class="primary-btn" bindtap="goPublish">发布新仪器</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading-state">正在同步你的仪器列表...</view>

  <view wx:elif="{{!canManage}}" class="section">
    <view class="card panel empty-panel">
      <view class="empty-title">当前还不能管理仪器</view>
      <view class="empty-copy">认证状态：{{certificationStatus}}</view>
      <view class="hero-copy">{{pendingMessage}}</view>
      <view class="primary-btn top-btn" bindtap="goCertification">先去完成认证</view>
    </view>
  </view>

  <view wx:elif="{{!list.length}}" class="section">
    <view class="card panel empty-panel">
      <view class="empty-title">你还没有发布过仪器</view>
      <view class="empty-copy">当前这里就是空的。等你发布第一台仪器后，这里才会出现自己的设备列表。</view>
      <view class="light-btn top-btn" bindtap="goPublish">去发布第一台仪器</view>
    </view>
  </view>

  <view wx:else class="section list-stack">
    <view class="card panel" wx:for="{{list}}" wx:key="id">
      <view class="feature-top">
        <view class="feature-title">{{item.name}}</view>
        <view class="badge">{{item.publishStatus}}</view>
      </view>
      <view class="meta-text">{{item.category}} · {{item.priceLabel}} · {{item.salePriceLabel}}</view>
      <view class="feature-copy">{{item.desc}}</view>
      <view class="chip-row">
        <view class="chip active" wx:for="{{item.tradeModes}}" wx:key="*this">{{item}}</view>
      </view>
      <view class="light-btn top-btn" data-id="{{item.id}}" bindtap="goEdit">编辑仪器</view>
    </view>
  </view>
</view>
