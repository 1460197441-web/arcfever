.category-page {
  padding-bottom: 100rpx;
}

.category-copy {
  margin-bottom: 18rpx;
}

.category-shell {
  display: flex;
  gap: 18rpx;
  padding: 0 24rpx;
}

.category-sidebar {
  width: 184rpx;
  height: calc(100vh - 240rpx);
  border-radius: 26rpx;
  background: #f8fafc;
}

.category-tab {
  padding: 28rpx 20rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #64748b;
}

.category-tab.active {
  background: #ffffff;
  color: #111111;
  font-weight: 700;
  box-shadow: inset 6rpx 0 0 #0ea5e9;
}

.category-main {
  flex: 1;
  height: calc(100vh - 240rpx);
}

.category-main-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 22rpx;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.category-cell {
  padding: 24rpx 20rpx;
  min-height: 188rpx;
}

.category-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  background: #eff6ff;
  color: #0ea5e9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
}

.category-cell-title {
  margin-top: 18rpx;
  font-size: 27rpx;
  font-weight: 700;
  color: #111111;
}

.category-cell-note {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #64748b;
}

.school-panel {
  margin-top: 24rpx;
  padding: 24rpx;
}

.school-row + .school-row {
  margin-top: 20rpx;
}

.school-name {
  font-size: 25rpx;
  font-weight: 700;
  color: #111111;
}

.school-colleges {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #64748b;
}
