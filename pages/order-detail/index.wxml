<view class="page-shell">
  <view class="nav-row">
    <view class="back-btn" bindtap="goBack">‹</view>
  </view>

  <view wx:if="{{!order}}" class="loading-state">正在加载订单详情...</view>

  <view wx:else>
    <view class="hero-panel">
      <view class="hero-tag">订单详情</view>
      <view class="hero-title">{{instrument ? instrument.name : (order.topic || '远程实验咨询')}}</view>
      <view class="hero-copy">{{order.id}} · {{order.createdAt}}</view>
    </view>

    <view class="detail-block">
      <view class="block-card">
        <view class="row-between">
          <text class="row-label">订单状态</text>
          <text class="row-value">{{order.status}}</text>
        </view>
        <view class="row-between">
          <text class="row-label">交易模式</text>
          <text class="row-value">{{order.tradeMode}}</text>
        </view>
        <view class="row-between">
          <text class="row-label">买家 / 卖家</text>
          <text class="row-value">{{order.buyerName}} / {{order.sellerName}}</text>
        </view>
        <view class="row-between" wx:if="{{order.tradeMode === '租赁'}}">
          <text class="row-label">租期</text>
          <text class="row-value">{{order.startDate}} ~ {{order.endDate}}（{{order.rentDays}} 天）</text>
        </view>
        <view class="row-between" wx:if="{{order.tradeMode === '出售'}}">
          <text class="row-label">交付方式</text>
          <text class="row-value">平台验货与物流交付</text>
        </view>
        <view class="row-between" wx:if="{{order.tradeMode === '远程实验咨询'}}">
          <text class="row-label">联系方式</text>
          <text class="row-value">{{order.contact}}</text>
        </view>
      </view>
    </view>

    <view class="summary-card">
      <view class="summary-title">费用明细</view>
      <view class="summary-row" wx:if="{{order.tradeMode === '租赁'}}">
        <text>租金</text>
        <text>¥{{order.rentalAmount}}</text>
      </view>
      <view class="summary-row" wx:if="{{order.tradeMode === '出售'}}">
        <text>买断金额</text>
        <text>¥{{order.saleAmount}}</text>
      </view>
      <view class="summary-row">
        <text>保险</text>
        <text>¥{{order.insuranceFee || 0}}</text>
      </view>
      <view class="summary-row">
        <text>押金</text>
        <text>¥{{order.deposit || 0}}</text>
      </view>
      <view class="summary-row">
        <text>平台服务费</text>
        <text>¥{{order.platformServiceFee || 0}}</text>
      </view>
      <view class="summary-row total">
        <text>总额</text>
        <text>¥{{order.total}}</text>
      </view>
    </view>

    <view class="info-grid">
      <view class="info-card">
        <view class="info-label">协议名称</view>
        <view class="info-value">{{agreement.title}}</view>
      </view>
      <view class="info-card">
        <view class="info-label">保险方案</view>
        <view class="info-value">{{order.insuranceAccepted ? order.insurancePlan.name : '未启用保险'}}</view>
      </view>
    </view>

    <view class="detail-block">
      <view class="block-card">
        <view class="row-between">
          <text class="row-label">争议与保障</text>
          <text class="inline-link" bindtap="goAgreement">查看协议</text>
        </view>
        <view class="line-list">
          <view class="line-item">• 若设备参数、交付状态或损坏责任存在分歧，可直接发起平台纠纷工单。</view>
          <view class="line-item">• 平台会结合聊天记录、验机记录、协议勾选和订单状态进行处理。</view>
          <view class="line-item">• 当前订单的保险、协议、押金与纠纷状态已做联动。</view>
        </view>
      </view>
    </view>

    <view class="action-row-inline">
      <view class="soft-button" bindtap="goChat">联系对方</view>
      <view wx:if="{{instrument && (order.status === '已完成' || order.status === '平台已结案')}}" class="soft-button" bindtap="goRating">发布评价</view>
      <view wx:if="{{order.disputeEligible}}" class="warn-button" bindtap="raiseDispute">发起纠纷</view>
    </view>
  </view>
</view>
