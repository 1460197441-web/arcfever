<view class="page-shell">
  <view class="topbar">
    <text class="topbar-icon" bindtap="goBack">‹</text>
    <text class="brand">Message.</text>
    <view class="topbar-actions">
      <text wx:if="{{chat && chat.orderId}}" class="inline-link" bindtap="openOrder">看订单</text>
      <text wx:elif="{{chat && chat.instrumentId}}" class="inline-link" bindtap="openInstrument">看设备</text>
    </view>
  </view>

  <view wx:if="{{chat}}">
    <view class="screen-pad">
      <view class="author-row">
        <view class="author-left">
          <view class="avatar a1"></view>
          <view class="author-meta">
            <view class="author-name-row">
              <text class="author-name">{{chat.counterpartName || chat.sellerName}}</text>
              <view class="verify-badge">V</view>
            </view>
            <text class="author-inst">{{chat.counterpartRole || chat.sellerRole}} · {{chat.instrumentName}}</text>
          </view>
        </view>
      </view>
      <view wx:if="{{chat.orderId}}" class="helper-note">当前会话已绑定订单 {{chat.orderId}}</view>
    </view>

    <view class="action-row-inline">
      <view wx:if="{{chat.orderId}}" class="soft-button" bindtap="openOrder">查看订单</view>
      <view wx:if="{{chat.instrumentId}}" class="soft-button" bindtap="openInstrument">查看设备详情</view>
      <view class="warn-button" bindtap="requestSupport">
        {{chat.supportIntervened ? '客服已介入' : '申请平台介入'}}
      </view>
    </view>
  </view>

  <view class="message-board">
    <view class="message {{item.from}}" wx:for="{{messages}}" wx:key="time">
      <view class="message-bubble">{{item.text}}</view>
      <view class="message-time">{{item.time}}</view>
    </view>
  </view>

  <view class="composer-bar">
    <textarea
      class="composer-input"
      placeholder="输入你要确认的设备参数、交付方式、排期或发票需求"
      value="{{inputText}}"
      bindinput="onInput"
      auto-height
    ></textarea>
    <view class="composer-send" bindtap="sendMessage">发送</view>
  </view>
</view>
