<view class="page-shell admin-login-page">
  <view class="nav-row">
    <view class="back-btn" bindtap="goBack">‹</view>
  </view>

  <view class="hero-panel">
    <view class="hero-tag">管理员入口</view>
    <view class="hero-title">审核与后台管理登录</view>
    <view class="hero-copy">输入管理员口令后，可进入认证审核、举报处理、纠纷处理和学校学院维护页面。</view>
  </view>

  <view class="section">
    <view class="card panel admin-login-panel">
      <view class="form-group">
        <view class="form-label">账号</view>
        <input class="form-input" value="{{username}}" placeholder="请输入管理员账号" data-field="username" bindinput="onInput" />
      </view>

      <view class="form-group">
        <view class="form-label">密码</view>
        <input class="form-input" password value="{{password}}" placeholder="请输入管理员密码" data-field="password" bindinput="onInput" />
      </view>

      <view class="primary-btn full-btn top-gap" bindtap="submit">{{loading ? '登录中...' : '进入审核后台'}}</view>
    </view>
  </view>
</view>
