.detail-media-wrap {
  padding: 8rpx 24rpx 0;
}

.detail-media-card {
  position: relative;
  height: 440rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: linear-gradient(145deg, #06080d 0%, #0f1724 58%, #151d2a 100%);
  box-shadow: 0 26rpx 54rpx rgba(15, 23, 42, 0.18);
}

.detail-media-fallback {
  width: 100%;
  height: 100%;
  padding: 34rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.detail-media-kicker {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.58);
}

.detail-media-title {
  margin-top: 18rpx;
  max-width: 84%;
  font-size: 40rpx;
  line-height: 1.28;
  font-weight: 800;
  color: #ffffff;
}

.detail-media-copy {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.72);
}

.detail-actions {
  margin-top: 20rpx;
}

.total-chip {
  background: #111111;
  color: #ffffff;
}

.date-block {
  margin-top: 18rpx;
}

.picker-action {
  min-width: 144rpx;
  padding: 0 24rpx;
}

.insurance-select {
  margin-top: 12rpx;
}

.detail-top-gap {
  margin-top: 24rpx;
}

.top-gap-plain {
  margin-top: 24rpx;
}

.compact-feed {
  gap: 32rpx;
}
