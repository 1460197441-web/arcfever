<view class="page-shell profile-page">
  <view class="topbar">
    <text class="brand">Profile.</text>
  </view>

  <view wx:if="{{loading}}" class="loading-state">正在加载个人中心...</view>

  <view wx:elif="{{profile}}">
    <view class="profile-hero compact-shadow-card">
      <view class="profile-cover">
        <view class="cover-overlay">
          <view class="author-row compact-author-row">
            <view class="author-left">
              <view class="avatar a1"></view>
              <view class="author-meta">
                <view class="author-name-row">
                  <text class="author-name">{{profile.certification.name || '未认证用户'}}</text>
                  <view
                    wx:if="{{profile.certification.status === '已认证' || profile.certification.status === '已通过'}}"
                    class="verify-badge"
                  >
                    V
                  </view>
                </view>
                <text class="author-inst">
                  {{profile.certification.role || '普通用户'}} · {{profile.certification.school || '待选择学校'}} /
                  {{profile.certification.college || '待选择学院'}}
                </text>
              </view>
            </view>
            <view class="status-badge light">{{profile.certification.status}}</view>
          </view>
        </view>
      </view>

      <view class="profile-summary">
        <view class="summary-item">
          <view class="summary-value">{{profile.instrumentCount}}</view>
          <view class="summary-label">我的仪器</view>
        </view>
        <view class="summary-item">
          <view class="summary-value">{{profile.orderCount}}</view>
          <view class="summary-label">订单</view>
        </view>
        <view class="summary-item">
          <view class="summary-value">{{profile.favoriteCount}}</view>
          <view class="summary-label">收藏</view>
        </view>
      </view>
    </view>

    <view class="hero-copy compact-copy">{{profile.certification.pendingMessage}}</view>

    <view class="info-grid detail-top-gap">
      <view class="info-card compact-shadow-card">
        <view class="info-label">联系电话</view>
        <view class="info-value">{{profile.certification.phone || '未填写'}}</view>
      </view>
      <view class="info-card compact-shadow-card">
        <view class="info-label">机构邮箱</view>
        <view class="info-value">{{profile.certification.email || '未填写'}}</view>
      </view>
      <view class="info-card compact-shadow-card">
        <view class="info-label">学工号 / 工号</view>
        <view class="info-value">{{profile.certification.instituteId || '未填写'}}</view>
      </view>
      <view class="info-card compact-shadow-card">
        <view class="info-label">证明文件</view>
        <view class="info-value">{{profile.certification.proofName || '未上传'}}</view>
      </view>
    </view>

    <view class="panel-title">个人操作</view>
    <view class="section">
      <view class="action-card compact-shadow-card">
        <view class="action-item" data-page="/pages/certification/index" bindtap="goPage">
          <view>
            <view class="action-title">认证信息</view>
            <view class="action-subtitle">{{profile.certification.status}}</view>
          </view>
          <view class="action-arrow">›</view>
        </view>

        <view class="action-item" data-page="/pages/my-instruments/index" bindtap="goPage">
          <view>
            <view class="action-title">我发布的</view>
            <view class="action-subtitle">管理个人设备与上架状态</view>
          </view>
          <view class="action-arrow">›</view>
        </view>

        <view class="action-item" data-page="/pages/order-list/index" bindtap="goPage">
          <view>
            <view class="action-title">订单列表</view>
            <view class="action-subtitle">查看交易进度与纠纷状态</view>
          </view>
          <view class="action-arrow">›</view>
        </view>

        <view class="action-item" data-page="/pages/favorite-list/index" bindtap="goPage">
          <view>
            <view class="action-title">我的收藏</view>
            <view class="action-subtitle">快速回到关注中的仪器</view>
          </view>
          <view class="action-arrow">›</view>
        </view>

        <view class="action-item" data-page="/pages/rating-list/index" bindtap="goPage">
          <view>
            <view class="action-title">评价管理</view>
            <view class="action-subtitle">沉淀口碑与交易反馈</view>
          </view>
          <view class="action-arrow">›</view>
        </view>

        <view wx:if="{{!profile.certification.isAdmin}}" class="action-item" bindtap="goAdminLogin">
          <view>
            <view class="action-title">管理员入口</view>
            <view class="action-subtitle">进入审核后台</view>
          </view>
          <view class="action-arrow">›</view>
        </view>

        <view wx:if="{{profile.certification.isAdmin}}" class="action-item" data-page="/pages/admin/index" bindtap="goPage">
          <view>
            <view class="action-title">管理后台</view>
            <view class="action-subtitle">学校学院、认证审核、举报与纠纷</view>
          </view>
          <view class="action-arrow">›</view>
        </view>
      </view>
    </view>

    <view wx:if="{{profile.certification.isAdmin}}" class="section logout-wrap">
      <view class="logout-btn" bindtap="adminLogout">退出管理员身份</view>
    </view>
  </view>
</view>
