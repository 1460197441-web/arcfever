.profile-page {
  padding-bottom: 180rpx;
}

.profile-hero {
  margin: 0 24rpx;
  overflow: hidden;
}

.profile-cover {
  height: 248rpx;
  background:
    radial-gradient(circle at 80% 18%, rgba(14, 165, 233, 0.18), transparent 20%),
    linear-gradient(145deg, #05070b 0%, #0d1522 62%, #141c29 100%);
}

.cover-overlay {
  height: 100%;
  padding: 28rpx 26rpx;
  background: linear-gradient(180deg, rgba(5, 7, 12, 0.12) 0%, rgba(5, 7, 12, 0.28) 100%);
}

.compact-author-row {
  margin-bottom: 0;
}

.profile-cover .author-name,
.profile-cover .author-inst {
  color: #ffffff;
}

.profile-cover .status-badge.light {
  background: rgba(5, 7, 12, 0.42);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.profile-summary {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  padding: 24rpx 24rpx 28rpx;
  background: #ffffff;
}

.summary-item {
  text-align: center;
}

.summary-value {
  font-size: 34rpx;
  font-weight: 800;
  color: #111111;
}

.summary-label {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #6b7280;
}

.compact-copy {
  margin-top: 18rpx;
  font-size: 26rpx;
}

.action-card {
  padding: 14rpx 24rpx;
}

.action-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 28rpx 0;
}

.action-item + .action-item {
  border-top: 1rpx solid #f1f5f9;
}

.action-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111111;
}

.action-subtitle {
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: #6b7280;
}

.action-arrow {
  font-size: 38rpx;
  color: #94a3b8;
}

.logout-wrap {
  margin-top: 24rpx;
}

.logout-btn {
  width: 100%;
  min-height: 98rpx;
  border-radius: 28rpx;
  background: #111111;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
}
