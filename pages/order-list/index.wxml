<view class="page-shell">
  <view class="nav-row">
    <view class="back-btn" bindtap="goBack">‹</view>
  </view>

  <view class="hero-panel">
    <view class="hero-tag">订单列表</view>
    <view class="hero-title">查看租赁、买断与纠纷状态</view>
    <view class="hero-copy">所有下单、支付、履约与平台介入记录都会在这里统一沉淀。</view>
  </view>

  <view wx:if="{{loading}}" class="loading-state">正在同步订单列表...</view>

  <view wx:elif="{{!list.length}}" class="section order-empty-shell">
    <view class="card panel empty-panel">
      <view class="order-empty-icon">◎</view>
      <view class="empty-title">暂无交易记录</view>
      <view class="empty-copy">你的科研之旅还没开始，先去广场看看有哪些认证设备，或者直接发起远程实验咨询。</view>
      <view class="order-empty-actions">
        <view class="primary-btn full-btn" bindtap="goEquipment">去仪器广场</view>
        <view class="light-btn full-btn" bindtap="goRemoteLab">发起远程实验咨询</view>
      </view>
    </view>
  </view>

  <view wx:else class="section list-stack order-list-stack">
    <view class="card panel order-card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="openOrder">
      <view class="feature-top">
        <view>
          <view class="feature-title">{{(item.instrument && item.instrument.name) || item.instrumentName || '远程实验咨询'}}</view>
          <view class="meta-text">{{item.tradeMode}} · {{item.id}}</view>
        </view>
        <view class="status-badge order-status">{{item.status}}</view>
      </view>

      <view class="meta-text">{{item.createdAt}}</view>

      <view class="row-between" wx:if="{{item.tradeMode === '租赁'}}">
        <text class="row-label">租期</text>
        <text class="row-value">{{item.startDate}} ~ {{item.endDate}}</text>
      </view>

      <view class="row-between" wx:if="{{item.tradeMode === '出售'}}">
        <text class="row-label">交付</text>
        <text class="row-value">平台验货与物流交付</text>
      </view>

      <view class="row-between">
        <text class="row-label">总额</text>
        <text class="row-value">¥{{item.amount}}</text>
      </view>
    </view>
  </view>
</view>
