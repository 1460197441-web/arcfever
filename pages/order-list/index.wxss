.order-empty-shell {
  padding-top: 36rpx;
}

.order-empty-icon {
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto 28rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(15, 23, 42, 0.04);
  color: #111111;
  font-size: 42rpx;
  font-weight: 700;
}

.order-empty-actions {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 32rpx;
}

.order-list-stack {
  margin-top: 28rpx;
}

.order-card {
  padding: 32rpx;
}

.order-status {
  background: rgba(15, 23, 42, 0.08);
  color: #111111;
}
