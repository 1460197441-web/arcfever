<view class="page-shell">
  <view class="nav-row">
    <view class="back-btn" bindtap="goBack">‹</view>
  </view>

  <view class="hero-panel">
    <view class="hero-tag">我的收藏</view>
    <view class="hero-title">把想持续跟进的仪器先收藏起来</view>
    <view class="hero-copy">这里展示的是你主动收藏的在架仪器，方便你回看参数、联系发布方，或者继续进入下单流程。</view>
  </view>

  <view wx:if="{{loading}}" class="loading-state">正在获取收藏列表...</view>

  <view wx:elif="{{!list.length}}" class="section">
    <view class="card panel empty-panel">
      <view class="empty-title">你还没有收藏任何仪器</view>
      <view class="empty-copy">先去仪器广场逛一圈，把感兴趣的设备加入收藏，后面会更快进入沟通和交易流程。</view>
      <view class="light-btn top-gap" bindtap="goEquipment">去广场找仪器</view>
    </view>
  </view>

  <view wx:else class="section list-stack">
    <view class="card panel favorite-card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="openInstrument">
      <view class="feature-top">
        <view>
          <view class="feature-title">{{item.name}}</view>
          <view class="meta-text">{{item.school}} / {{item.college}}</view>
        </view>
        <view class="feature-price">{{item.priceLabel}}</view>
      </view>
      <view class="feature-copy">{{item.desc}}</view>
      <view class="chip-row top-gap">
        <view class="chip active" wx:for="{{item.tradeModes}}" wx:key="*this">{{item}}</view>
      </view>
      <view class="helper-note">发布方 {{item.sellerName}} · {{item.location}}</view>
    </view>
  </view>
</view>
