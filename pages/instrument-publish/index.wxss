.no-gap {
  margin-top: 0;
}

.form-wrap {
  padding: 0 24rpx 18rpx;
}

.upload-panel {
  margin-top: 12rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 36rpx rgba(15, 23, 42, 0.06);
}

.upload-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
}

.upload-add,
.upload-item {
  position: relative;
  aspect-ratio: 1 / 1;
  border-radius: 24rpx;
  overflow: hidden;
}

.upload-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background:
    radial-gradient(circle at 80% 18%, rgba(14, 165, 233, 0.16), transparent 18%),
    linear-gradient(145deg, #06080d 0%, #0f1724 58%, #151d2a 100%);
  color: #ffffff;
}

.upload-plus {
  font-size: 54rpx;
  font-weight: 300;
  line-height: 1;
}

.upload-add-copy {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
}

.upload-image {
  width: 100%;
  height: 100%;
}

.upload-remove {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 42rpx;
  height: 42rpx;
  border-radius: 999rpx;
  background: rgba(5, 7, 12, 0.68);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
}

.upload-hint {
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #6b7280;
}

.field-input,
.field-select,
.field-textarea {
  width: 100%;
  padding: 30rpx 26rpx;
  line-height: 1.9;
}

.field-textarea {
  min-height: 260rpx;
}

.switch-row {
  padding: 24rpx 0;
}
